# Copy to scripts/testflight.env (gitignored) and fill values.

# App Store Connect API key values:
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
ASC_API_KEY_ID=YOUR_KEY_ID
ASC_API_ISSUER_ID=YOUR_ISSUER_ID

# Preferred: full path to the downloaded AuthKey_<KEYID>.p8 file
ASC_API_P8_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Optional alternative to ASC_API_P8_PATH:
# API_PRIVATE_KEYS_DIR=/Users/yourname/.appstoreconnect/private_keys

# Optional (only needed if flutter is not on PATH)
# FLUTTER_BIN=/Users/yourname/flutter/bin/flutter
